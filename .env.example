# Copy to `.env.local` and fill in. `.env*` is gitignored — never commit real values.
#
# The site runs without any of these: emails are logged to the console instead
# of sent, so the whole RSVP and contact flow is testable with no credentials.

# ─── Resend (transactional email) ──────────────────────────────────────────
# Server-side only. Never expose this to the browser (no NEXT_PUBLIC_ prefix).
RESEND_API_KEY=

# Sender, as: "Display Name <address>". Always include the display name --
# with a bare address, Resend falls back to your account name, which is what
# recipients then see in their inbox.
# Testing:    "Kata Nylen <onboarding@resend.dev>"
# Production: "Kata Nylen <hej@katanylen.com>"  (needs the domain verified)
CONTACT_FROM_EMAIL=

# Where contact-form enquiries and RSVP notifications are delivered.
CONTACT_TO_EMAIL=

# ─── Google Sheets (RSVP attendee list) ────────────────────────────────────
# Set up instructions: docs/google-sheets-setup.md
# With these unset, RSVPs are logged and emailed instead of written to a sheet.

# The long id from the sheet URL:
#   docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# Service account address, ending in .iam.gserviceaccount.com.
# The sheet must be shared with this address as an Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The `private_key` value from the service account JSON, in double quotes and
# keeping its literal \n sequences exactly as they appear in the file.
GOOGLE_PRIVATE_KEY=

# Tab name within the spreadsheet. Defaults to "RSVPs".
GOOGLE_SHEETS_TAB_NAME=

# Optional guest cap. When set, RSVPs that would exceed it are refused.
RSVP_CAPACITY=

# ─── Google Static Maps (optional) ─────────────────────────────────────────
# Renders a map of the venue on the book release page. Without it the page
# shows the address and a directions link, which works fine.
#
# Server-side only, and never exposed: the image is fetched by our own
# /api/venue-map route and streamed back, so the key does not reach the
# browser. Restrict it to the Static Maps API in the Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# ─── Notes on keys we deliberately do NOT use ──────────────────────────────
#
# Maps JavaScript API — not used. For one fixed venue it ships a large
#   bundle, hurts Core Web Vitals, and exposes a key in the browser. The
#   static image above does the job.
#
# Google Calendar API — not needed. "Add to calendar" is served as an .ics
#   file and a plain calendar link. Using the Calendar API to auto-invite RSVPs
#   would expose every guest's email address to every other guest.
